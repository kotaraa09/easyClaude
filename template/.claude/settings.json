{
  "extraKnownMarketplaces": {
    "easyclaude": {
      "source": {
        "source": "github",
        "repo": "kotaraa09/easyClaude"
      }
    }
  },
  "enabledPlugins": {
    "easyclaude@easyclaude": true
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)",
      "Bash(chmod 777 *)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(zsh)",
      "Bash(sh -s *)",
      "Bash(bash -s *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -fdx *)",
      "PowerShell(Remove-Item -Recurse -Force C:*)",
      "PowerShell(Remove-Item -Force -Recurse C:*)",
      "PowerShell(Remove-Item -Recurse -Force ~*)",
      "PowerShell(Remove-Item -Force -Recurse ~*)",
      "PowerShell(Invoke-Expression)",
      "PowerShell(Invoke-Expression *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.git/**)",
      "Edit(./**/package-lock.json)",
      "Edit(./**/pnpm-lock.yaml)",
      "Edit(./**/yarn.lock)",
      "Edit(./**/poetry.lock)",
      "Edit(./**/uv.lock)",
      "Edit(./**/Cargo.lock)",
      "Edit(./**/go.sum)"
    ]
  }
}
