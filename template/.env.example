# Copy this file to .env and fill in what you have.
# .env is gitignored and Claude is denied read access to it - a setup script
# reads it instead, so your keys never enter the model context.

# --- easyClaude connectors -------------------------------------------
# Fill in only what you have. Anything left blank stays switched off.
# Then run: node scripts/connect.mjs --apply

# current library docs, so it stops guessing at APIs that changed
# get one: https://context7.com/dashboard
CONTEXT7_API_KEY=

# query your database directly instead of guessing at the schema
# get one: your own database, e.g. postgres://user:pass@localhost:5432/dbname
DATABASE_URL=

# issues and pull requests without leaving the session
# get one: https://github.com/settings/tokens
GITHUB_TOKEN=

# image, video, audio, 3d generation - aggregator - one key covers every modality
# get one: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# audio generation - speech and sound effects - the gap Replicate's musicgen cannot fill
# get one: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# image, audio generation - a ChatGPT Plus subscription does NOT include this - it is billed separately
# get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# image generation - privacy-focused aggregator; 39 image models including flux and gpt-image
# get one: https://venice.ai/settings/api
VENICE_API_KEY=

# image generation - a Gemini Advanced subscription does NOT include this - the API key is separate
# get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Browser sign-in only, no key to paste: figma, notion, linear, slack, atlassian, sentry
# Add those with /mcp inside Claude Code.

