{
  "_comment": "Merged into the project's .claude/settings.json permissions.deny by the kickoff skill. Guardrails that need no runtime.",
  "deny": [
    "Bash(rm -rf /*)",
    "Bash(rm -rf ~*)",
    "Bash(git push --force:*)",
    "Bash(git push -f:*)",
    "Bash(git reset --hard:*)",
    "Bash(git clean -fdx:*)",
    "Bash(chmod 777:*)",
    "Bash(curl:* | sh)",
    "Bash(curl:* | bash)",
    "Bash(wget:* | sh)",
    "Read(./.env)",
    "Read(./.env.*)",
    "Read(./**/*.pem)",
    "Read(./**/id_rsa)",
    "Edit(./.env)",
    "Edit(./.env.*)",
    "Edit(./.git/**)",
    "Edit(./**/package-lock.json)",
    "Edit(./**/pnpm-lock.yaml)",
    "Edit(./**/yarn.lock)",
    "Edit(./**/poetry.lock)",
    "Edit(./**/uv.lock)",
    "Edit(./**/Cargo.lock)",
    "Edit(./**/go.sum)"
  ]
}
